PORT=3000
NODE_ENV=production
DB_HOST=localhost
DB_USER=restaurant_app
DB_PASSWORD=
DB_NAME=restaurant_qr_db

# Comma-separated list of allowed browser origins for API requests that are
# served from a different origin than the API itself. Leave empty to disable
# CORS (recommended when the frontend and API are served by the same host).
CORS_ORIGIN=

# Signing secret for staff session JWTs. MUST be at least 16 characters and
# kept secret. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Base URL the QR codes / links are generated against (public domain or LAN
# IP the restaurant generates QR codes with). Used by scripts/generate-qr.js.
APP_BASE_URL=

# Business calendar timezone used for per-day order numbering (e.g. Asia/Kolkata).
# Defaults to Asia/Kolkata when unset.
TIMEZONE=Asia/Kolkata

# restaurant id used by default when none is passed explicitly
# (QR flow / table listing). Defaults to 1 when unset.
DEFAULT_RESTAURANT_ID=1

# Pexels API key (server-side only, never exposed to the browser).
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=